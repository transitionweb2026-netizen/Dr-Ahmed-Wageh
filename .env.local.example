# Copy this file to .env.local and fill in real values from your Supabase project
# (Project Settings -> Database for the two connection strings, Project Settings
# -> API for the URL/keys). Never commit .env.local.

# Pooled connection (port 6543, PgBouncer transaction mode) — used by the app at runtime.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (port 5432) — used only by the Prisma CLI for migrations.
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# Used once by scripts/create-admin-user.ts to seed the single /admin account.
# Rotate the password afterwards from the Supabase Auth dashboard.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-strong-password"
